@page
@model eShopLegacyWebForms.Pages.IndexModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="esh-table">
    <p class="esh-link-wrapper">
        <a asp-page-handler="Create" asp-page="/Catalog/CreateItem" class="btn esh-button esh-button-primary">
            Create New
        </a>
    </p>

    <table class="table">
        <thead>
            <tr class="esh-table-header">
                <th></th>
                <th>Name</th>
                <th>Description</th>
                <th>Brand</th>
                <th>Type</th>
                <th>Price</th>
                <th>Picture name</th>
                <th>Stock</th>
                <th>Restock</th>
                <th>Max stock</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Model.Data)
            {
                <tr>
                    <td>
                        <image class="esh-thumbnail" src='/Pics/@item.PictureFileName' />
                    </td>
                    <td><p>@item.Name</p></td>
                    <td><p>@item.Description</p></td>
                    <td><p>@item.CatalogBrand.Brand</p></td>
                    <td><p>@item.CatalogType.Type</p></td>
                    <td><p><span class="esh-price">@item.Price</span></p></td>
                    <td><p>@item.PictureFileName</p></td>
                    <td><p>@item.AvailableStock</p></td>
                    <td><p>@item.RestockThreshold</p></td>
                    <td><p>@item.MaxStockThreshold</p></td>
                    <td>
                        <a asp-page-handler="Edit" asp-page="/Catalog/EditItem" asp-route-id="@item.Id" class="esh-table-link">Edit</a>
                        |
                        <a asp-page-handler="Details" asp-page="/Catalog/DetailsItem" asp-route-id="@item.Id" class="esh-table-link">Details</a>
                        |
                        <a asp-page-handler="Delete" asp-page="/Catalog/DeleteItem" asp-route-id="@item.Id" class="esh-table-link">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="esh-pager">
    <div class="container">
        <article class="esh-pager-wrapper row">
            <nav>
                <a asp-page-handler="Index" asp-route-index="@(Model.Model.ActualPage - 1)" asp-route-size="@Model.Model.ItemsPerPage"
                   class="esh-pager-item @(Model.Model.ActualPage > 0 ? "esh-pager-item--navigable" : "esh-pager-item--hidden")">
                    Previous
                </a>
                <span class="esh-pager-item">Showing @Model.Model.ItemsPerPage of @Model.Model.TotalItems products - Page @(Model.Model.ActualPage + 1) - @Model.Model.TotalPages</span>
                <a asp-page-handler="Index" asp-route-index="@(Model.Model.ActualPage + 1)" asp-route-size="@Model.Model.ItemsPerPage"
                   class="esh-pager-item @(Model.Model.ActualPage < Model.Model.TotalPages - 1 ? "esh-pager-item--navigable" : "esh-pager-item--hidden")">
                    Next
                </a>
            </nav>
        </article>
    </div>
</div>
