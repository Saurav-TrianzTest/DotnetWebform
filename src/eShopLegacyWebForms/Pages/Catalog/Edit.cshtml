@page "{id:int}"
@{
    Layout = "_Layout";
}
@model eShopLegacyWebForms.Catalog.EditModel

<div class="esh-body-title">Edit</div>

<div class="container">
    <div class="row">
        <img class="col-md-6 esh-picture" src='~/Pics/@Model.CatalogItem.PictureFileName' />
        <div class="col-md-6 form-horizontal">
            <form method="post">
                <div class="form-group">
                    <label class="control-label col-md-4">Name</label>
                    <div class="col-md-8">
                        <input asp-for="CatalogItem.Name" class="form-control" />
                        <span asp-validation-for="CatalogItem.Name" class="field-validation-valid text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Description</label>
                    <div class="col-md-8">
                        <input asp-for="CatalogItem.Description" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Brand</label>
                    <div class="col-md-8">
                        <select asp-for="CatalogItem.CatalogBrandId" asp-items="Model.Brands" class="form-control"></select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Type</label>
                    <div class="col-md-8">
                        <select asp-for="CatalogItem.CatalogTypeId" asp-items="Model.Types" class="form-control"></select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Price</label>
                    <div class="col-md-8">
                        <input asp-for="CatalogItem.Price" class="form-control" />
                        <span asp-validation-for="CatalogItem.Price" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Picture name</label>
                    <div class="col-md-8">
                        <input asp-for="CatalogItem.PictureFileName" class="form-control" readonly="readonly" title="Not allowed for edition" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Stock</label>
                    <div class="col-md-8">
                        <input asp-for="CatalogItem.AvailableStock" class="form-control" />
                        <span asp-validation-for="CatalogItem.AvailableStock" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Restock</label>
                    <div class="col-md-8">
                        <input asp-for="CatalogItem.RestockThreshold" class="form-control" />
                        <span asp-validation-for="CatalogItem.RestockThreshold" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-4">Max stock</label>
                    <div class="col-md-8">
                        <input asp-for="CatalogItem.MaxStockThreshold" class="form-control" />
                        <span asp-validation-for="CatalogItem.MaxStockThreshold" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-12 text-right esh-button-actions">
                        <a asp-page="/Index" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                        <button type="submit" class="btn esh-button esh-button-primary">[ Save ]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
